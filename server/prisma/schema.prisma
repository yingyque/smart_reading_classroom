// Prisma schema - 智慧阅读智能平台数据模型
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用 String 承载角色/消息类型，并在应用层用 TS 联合类型约束
// Role 取值：TEACHER | STUDENT
// MessageType 取值：PEER（学生↔学生）| AI（学生↔AI）

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  // 教师发放的 AI Key（AES-256-GCM 加密存储，格式 iv:tag:ciphertext）
  aiKey     String?
  // Key 指纹（HMAC-SHA256）。注：统一共享 Key 后不再要求唯一（多学生可共用同一指纹）
  aiKeyHash String?
  createdAt DateTime @default(now())

  // 关系
  taughtClassrooms Classroom[]    @relation("TeacherClassrooms")
  memberships      GroupMember[]
  messages         Message[]
  aiUsages         AiUsage[]
  workspaces       Workspace[]
  notes            Note[]
}

model Classroom {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // 课堂码，学生凭此加入
  teacherId String
  groupCount Int     @default(0)
  createdAt DateTime @default(now())

  teacher   User       @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  groups    Group[]
  documents Document[]
  messages  Message[]
  workspaces Workspace[]
  notes     Note[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  classroomId String
  createdAt   DateTime @default(now())

  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  messages  Message[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Document {
  id          String   @id @default(cuid())
  classroomId String
  title       String
  fileName    String
  fileType    String // pdf | docx | txt
  filePath    String // 本地存储路径
  content     String @db.Text // 抽取出的纯文本（用于 AI 上下文与分析）
  order       Int    @default(0) // 手动排序序号（越小越靠前）
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messages  Message[]
  notes     Note[]
}

model Message {
  id          String      @id @default(cuid())
  type        String // PEER | AI
  classroomId String
  groupId     String
  documentId  String?
  senderId    String // 发起学生（AI 回复也归属到触发它的学生）
  isAiReply   Boolean     @default(false) // true 表示该条为 AI 的回复
  content     String      @db.Text
  createdAt   DateTime    @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([groupId])
  @@index([type])
}

// 学生学习笔记：仅本人与课堂教师可见（应用层按 userId/teacherId 过滤）
model Note {
  id          String   @id @default(cuid())
  classroomId String
  userId      String // 笔记作者（学生本人）
  documentId  String? // 写笔记时正在阅读的文献；文献被删后置空（笔记保留）
  content     String   @db.Text
  kind        String   @default("text") // text=普通笔记 | highlight=文献高亮
  quote       String?  @db.Text // 高亮模式下选中的原文
  page        Int? // 高亮所在页码（1 起）
  rects       String?  @db.Text // 高亮选区矩形 JSON：[{x,y,w,h}]，归一化 0~1（相对页面）
  color       String? // 高亮颜色：blue | green | yellow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([classroomId, userId])
  @@index([classroomId, updatedAt])
}

model AiUsage {
  id          String   @id @default(cuid())
  classroomId String
  groupId     String
  userId      String
  documentId  String?
  promptChars Int      @default(0)
  replyChars  Int      @default(0)
  // 真实 token 用量（codebuddy --output-format json 的 result.usage）；历史记录为 0，展示时按字符估算
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([userId])
}

// 学生共享 AI Key 池：多个 Key 轮询分摊并发限流压力（AES-256-GCM 加密存储，明文不落盘）
model SharedKey {
  id          String   @id @default(cuid())
  encrypted   String
  fingerprint String   @unique
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 学生 AI 工作台容器：每 (classroom, student) 一个 CodeBuddy 容器
// status 取值：CREATED（已创建未运行）| RUNNING（运行中）| STOPPED（闲置停止，可唤醒）
model Workspace {
  id            String   @id @default(cuid())
  classroomId   String
  userId        String
  containerName String   @unique // src-ws-{classroomId前8}-{userId前8}
  status        String   @default("CREATED")
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([status, lastActiveAt])
}
