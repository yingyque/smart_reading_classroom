// Prisma schema - 智慧阅读智能平台数据模型
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用 String 承载角色/消息类型，并在应用层用 TS 联合类型约束
// Role 取值：TEACHER | STUDENT
// MessageType 取值：PEER（学生↔学生）| AI（学生↔AI）

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  // 教师发放的 AI Key（AES-256-GCM 加密存储，格式 iv:tag:ciphertext）
  aiKey     String?
  // Key 指纹（HMAC-SHA256）。注：统一共享 Key 后不再要求唯一（多学生可共用同一指纹）
  aiKeyHash String?
  createdAt DateTime @default(now())

  // 关系
  taughtClassrooms Classroom[]    @relation("TeacherClassrooms")
  memberships      GroupMember[]
  messages         Message[]
  aiUsages         AiUsage[]
  workspaces       Workspace[]
}

model Classroom {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // 课堂码，学生凭此加入
  teacherId String
  groupCount Int     @default(0)
  createdAt DateTime @default(now())

  teacher   User       @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  groups    Group[]
  documents Document[]
  messages  Message[]
  workspaces Workspace[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  classroomId String
  createdAt   DateTime @default(now())

  classroom Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  messages  Message[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Document {
  id          String   @id @default(cuid())
  classroomId String
  title       String
  fileName    String
  fileType    String // pdf | docx | txt
  filePath    String // 本地存储路径
  content     String @db.Text // 抽取出的纯文本（用于 AI 上下文与分析）
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id          String      @id @default(cuid())
  type        String // PEER | AI
  classroomId String
  groupId     String
  documentId  String?
  senderId    String // 发起学生（AI 回复也归属到触发它的学生）
  isAiReply   Boolean     @default(false) // true 表示该条为 AI 的回复
  content     String      @db.Text
  createdAt   DateTime    @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([groupId])
  @@index([type])
}

model AiUsage {
  id          String   @id @default(cuid())
  classroomId String
  groupId     String
  userId      String
  documentId  String?
  promptChars Int      @default(0)
  replyChars  Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([userId])
}

// 学生 AI 工作台容器：每 (classroom, student) 一个 CodeBuddy 容器
// status 取值：CREATED（已创建未运行）| RUNNING（运行中）| STOPPED（闲置停止，可唤醒）
model Workspace {
  id            String   @id @default(cuid())
  classroomId   String
  userId        String
  containerName String   @unique // src-ws-{classroomId前8}-{userId前8}
  status        String   @default("CREATED")
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([status, lastActiveAt])
}
