# ===== 服务端口 =====
# 本地开发用 4000；云平台（Render）会自动注入 PORT，无需手动设置
PORT=4000

# ===== 前端地址（CORS 白名单）=====
# 支持多个来源，用英文逗号分隔。
# 本地开发：http://localhost:5173
# 线上部署：填你的 Vercel 前端域名，例如 https://your-app.vercel.app
# 可同时保留两者：http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ===== JWT 密钥（请改成随机长字符串）=====
JWT_SECRET=change-me-to-a-long-random-secret

# ===== 数据库 =====
# 本地开发（SQLite）示例：DATABASE_URL="file:./dev.db"
#   注意：本仓库 schema 已切换为 PostgreSQL，本地若想用 SQLite 需改回 provider。
# 线上部署（PostgreSQL，Render 提供）示例：
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="postgresql://user:password@localhost:5432/smart_reading"

# ===== AI 接入（OpenAI 兼容接口）=====
# 接口地址，须以 /v1 结尾（示例为 DeepSeek/通义/Kimi/本地部署等）
AI_BASE_URL=https://api.deepseek.com/v1
# 你的 API Key
AI_API_KEY=sk-your-api-key-here
# 模型名
AI_MODEL=deepseek-chat
# 单次注入文献上下文的最大字符数
AI_CONTEXT_CHAR_LIMIT=6000
# AI 请求超时（毫秒）
AI_TIMEOUT_MS=60000
